{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poseguard-hub",
  "account_id": "978c8d2a53d9513955e60fd06f7e4b4d",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/.well-known/*"
    ]
  },
  "routes": [
    {
      "pattern": "poseguard.nanaoni.tech",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poseguard-hub",
      "database_id": "c3dec66e-aceb-4086-a7a0-11e67f85dd30",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "EventRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EventRoom"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://poseguard.nanaoni.tech",
    "ANDROID_CERT_SHA256": "E9:2F:A1:3A:C7:B3:48:F7:D9:F8:FB:61:1C:E3:1A:07:B7:91:99:DB:FC:D0:51:52:B7:D1:81:03:5B:9A:84:23"
  }
}
