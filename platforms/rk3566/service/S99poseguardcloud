#!/bin/sh
ROOT=/userdata/poseguard
DAEMON=$ROOT/bin/poseguard-relay
CONFIG=$ROOT/cloud.json
PIDFILE=/var/run/poseguard-cloud.pid
running(){ [ -s "$PIDFILE" ] || return 1; pid=$(cat "$PIDFILE"); case "$pid" in ''|*[!0-9]*)return 1;;esac; kill -0 "$pid" 2>/dev/null && [ "$(readlink /proc/$pid/exe)" = "$DAEMON" ]; }
case "$1" in
 start)
  [ -f "$CONFIG" ] || { echo 'PoseGuard cloud: enroll this device first'; exit 0; }
  running && exit 0
  mkdir -p "$ROOT/logs" "$ROOT/cloud-data"
  nohup "$DAEMON" run --config "$CONFIG" >>"$ROOT/logs/cloud.log" 2>&1 </dev/null &
  echo "$!" >"$PIDFILE"
  sleep 1
  running || exit 1
  echo 'PoseGuard cloud relay started'
  ;;
 stop)
  if running; then kill "$pid"; for tick in 1 2 3 4 5;do running || break;sleep 1;done;fi
  if running;then echo 'PoseGuard cloud relay is still stopping';exit 1;fi
  rm -f "$PIDFILE"
  ;;
 restart) "$0" stop && "$0" start ;;
 status) running && { echo 'PoseGuard cloud relay running';exit 0; };exit 1 ;;
 *) echo "Usage: $0 {start|stop|restart|status}";exit 2 ;;
esac
