#!/bin/sh

DAEMON=/userdata/poseguard/bin/poseguard-rk3566
RUNNER=/userdata/poseguard/bin/poseguard-run
CONFIG=/userdata/poseguard/config/poseguard.conf
PIDFILE=/var/run/poseguard.pid
LOGFILE=/userdata/poseguard/logs/poseguard.log

is_running() {
    [ -s "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE")
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null && [ "$(readlink "/proc/$pid/exe")" = "$DAEMON" ]
}

start_service() {
    mkdir -p /userdata/poseguard/logs /userdata/poseguard/runs
    if is_running; then
        echo "PoseGuard already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    rm -f "$PIDFILE"
    if [ ! -x "$DAEMON" ] || [ ! -x "$RUNNER" ]; then
        echo "PoseGuard executable missing: $DAEMON"
        return 1
    fi
    # BusyBox builds do not all implement start-stop-daemon -O.
    nohup "$RUNNER" --config "$CONFIG" >>"$LOGFILE" 2>&1 </dev/null &
    echo "$!" > "$PIDFILE"
    sleep 1
    if ! is_running; then
        echo "PoseGuard failed to start; see $LOGFILE"
        return 1
    fi
    echo "PoseGuard started (pid $(cat "$PIDFILE"))"
}

stop_service() {
    if is_running; then
        kill "$(cat "$PIDFILE")" || return 1
        for delay in 1 2 3 4 5; do
            is_running || break
            sleep 1
        done
    fi
    if is_running; then
        echo "PoseGuard has not stopped; keeping its pidfile"
        return 1
    fi
    rm -f "$PIDFILE"
    echo "PoseGuard stopped"
}

case "$1" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart)
        stop_service || exit 1
        start_service
        ;;
    status)
        if is_running; then
            echo "PoseGuard running (pid $(cat "$PIDFILE"))"
            exit 0
        fi
        echo "PoseGuard not running"
        exit 1
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 2
        ;;
esac
